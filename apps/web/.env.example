# URL of the deployed Cloudflare Worker
# For local dev: http://localhost:8787
# For production: https://quacky-api.<your-subdomain>.workers.dev
PUBLIC_API_URL=http://localhost:8787

# ─── Dashboard login (server-side only, never prefix with PUBLIC_) ───────────
# Single admin account. There is no signup page.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me-to-a-long-password
# Random string used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string
